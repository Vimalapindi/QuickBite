    {
      "id": 9,
      "type": "timeseries",
      "title": "Cache hit ratio",
      "description": "hits / (hits + misses)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 12
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(cache_operations_total{result=\"hit\"}[$__rate_interval])) / (sum(rate(cache_operations_total{result=\"hit\"}[$__rate_interval])) + sum(rate(cache_operations_total{result=\"miss\"}[$__rate_interval])))",
          "legendFormat": "overall",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "sum by (cache) (rate(cache_operations_total{result=\"hit\"}[$__rate_interval])) / (sum by (cache) (rate(cache_operations_total{result=\"hit\"}[$__rate_interval])) + sum by (cache) (rate(cache_operations_total{result=\"miss\"}[$__rate_interval])))",
          "legendFormat": "{{cache}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
