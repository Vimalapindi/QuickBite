# ---- App ----
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug
CORS_ORIGIN=http://localhost:5173,http://localhost:8080
TRUST_PROXY=0

# ---- PostgreSQL ----
POSTGRES_USER=quickbite
POSTGRES_PASSWORD=quickbite_dev_password
POSTGRES_DB=quickbite
# Host-based dev (npm run dev). Inside Docker, compose overrides this to use the "postgres" hostname.
DATABASE_URL=postgresql://quickbite:quickbite_dev_password@localhost:5432/quickbite
DB_POOL_MAX=20

# ---- Redis ----
REDIS_URL=redis://localhost:6379

# ---- RabbitMQ ----
RABBITMQ_USER=quickbite
RABBITMQ_PASSWORD=quickbite_dev_password
RABBITMQ_URL=amqp://quickbite:quickbite_dev_password@localhost:5672
QUEUE_PREFIX=quickbite

# ---- Auth ---- (CHANGE in any real deployment: openssl rand -hex 32)
JWT_SECRET=dev-only-secret-change-me-please-0123456789
JWT_EXPIRES_IN=2h

# ---- Rate limiting (Redis sliding window) ----
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SEC=60
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

# ---- Cache ----
CACHE_ENABLED=true
CACHE_TTL_SEC=60

# ---- Worker / simulations ----
PAYMENT_DELAY_MS=300
PAYMENT_FAILURE_RATE=0
OUTBOX_POLL_MS=200
DELIVERY_RETRY_DELAY_MS=5000
DELIVERY_MAX_ATTEMPTS=12
WORKER_METRICS_PORT=4001
DELIVERY_FEE_CENTS=4000

# ---- Grafana ----
GRAFANA_ADMIN_PASSWORD=admin
